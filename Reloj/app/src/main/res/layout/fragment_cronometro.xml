<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp">

    <TextView
        android:id="@+id/txt_titulo_cronometro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:text="Cronómetro"
        android:textColor="#FFFFFF"
        android:textSize="24sp" />

    <ImageView
        android:id="@+id/btn_menu_cronometro"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="32dp"
        android:contentDescription="Menu"
        android:src="@android:drawable/ic_menu_sort_by_size"
        app:tint="#FFFFFF" />

    <LinearLayout
        android:id="@+id/layout_tiempo_fijo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txt_titulo_cronometro"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="85dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/tv_h1" android:layout_width="30dp" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF" android:textSize="50sp" android:gravity="center" android:includeFontPadding="false" android:fontFamily="monospace"/>
        <TextView android:id="@+id/tv_h2" android:layout_width="30dp" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF" android:textSize="50sp" android:gravity="center" android:includeFontPadding="false" android:fontFamily="monospace"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=":" android:textColor="#FFFFFF" android:textSize="50sp" android:includeFontPadding="false"/>
        <TextView android:id="@+id/tv_m1" android:layout_width="30dp" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF" android:textSize="50sp" android:gravity="center" android:includeFontPadding="false" android:fontFamily="monospace"/>
        <TextView android:id="@+id/tv_m2" android:layout_width="30dp" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF" android:textSize="50sp" android:gravity="center" android:includeFontPadding="false" android:fontFamily="monospace"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=":" android:textColor="#FFFFFF" android:textSize="50sp" android:includeFontPadding="false"/>
        <TextView android:id="@+id/tv_s1" android:layout_width="30dp" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF" android:textSize="50sp" android:gravity="center" android:includeFontPadding="false" android:fontFamily="monospace"/>
        <TextView android:id="@+id/tv_s2" android:layout_width="30dp" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF" android:textSize="50sp" android:gravity="center" android:includeFontPadding="false" android:fontFamily="monospace"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=":" android:textColor="#FFFFFF" android:textSize="50sp" android:includeFontPadding="false"/>
        <TextView android:id="@+id/tv_c1" android:layout_width="30dp" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF" android:textSize="50sp" android:gravity="center" android:includeFontPadding="false" android:fontFamily="monospace"/>
        <TextView android:id="@+id/tv_c2" android:layout_width="30dp" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF" android:textSize="50sp" android:gravity="center" android:includeFontPadding="false" android:fontFamily="monospace"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="182dp"
        android:layout_height="152dp"
        android:layout_below="@id/layout_tiempo_fijo"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_iniciar_cronometro"
            android:layout_width="180dp"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button_border_dark"
            android:backgroundTint="@null"
            android:text="Iniciar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_restablecer_cronometro"
            android:layout_width="180dp"
            android:layout_height="50dp"
            android:background="@drawable/button_border_dark"
            android:backgroundTint="@null"
            android:text="Restablecer"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>
</RelativeLayout>